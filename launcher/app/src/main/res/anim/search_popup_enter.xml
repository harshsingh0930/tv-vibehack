<set xmlns:android="http://schemas.android.com/apk/res/android" android:interpolator="@android:anim/decelerate_interpolator">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="180" />
    <scale android:fromXScale="0.97" android:toXScale="1" android:fromYScale="0.97" android:toYScale="1"
        android:pivotX="50%" android:pivotY="20%" android:duration="200" />
    <translate android:fromYDelta="8dp" android:toYDelta="0" android:duration="200" />
</set>
